#!/sbin/sh
##########################################
#  镜像备份 提取辅助模块 v1.0.0
#  AOSP libsparse: img2simg / simg2img (arm64)
#  支持 Magisk / KernelSU / APatch
##########################################
OUTFD=$2
ZIPFILE=$3

ui_print() {
  echo -e "ui_print $1\nui_print" >> /proc/self/fd/$OUTFD
}

ui_print "=============================="
ui_print "  镜像备份 提取辅助模块 v1.0.0"
ui_print "  img2simg / simg2img (arm64)"
ui_print "=============================="

MODPATH=${0%/*}

unzip -o "$ZIPFILE" 'system/*' -d "$MODPATH" >/dev/null 2>&1
chmod 755 "$MODPATH/system/bin/"* 2>/dev/null

ui_print "- 安装完成，重启设备后生效"
ui_print "- App 将自动优先使用本模块二进制"
